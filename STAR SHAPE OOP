using System;
using System.Collection.Generic;

namespace StarShape
{
    class Program
    {
        cost int GridWidth = 70;
        cost int GridHeight = 35;

        static void Main(string[] args)
        {
        char[,]grid = new char[GridHeight, GridWidth];
        for(int r = 0; r < GridHeight; r++)
        {
            for(int c = 0;c < GridHeight; c++)
            {
                grid[r, c] = '';
            }
        }
            double centerX = GridWidth / 2.0;
            double centerY = GridHeight / 2.0;
            double outerRadius = 15.0;
            double innerRadius = 6.0;

            list<(double x, double y)> starVertices = GetStarVertices (centerX, centerY, outerRadius, innerRadius, 5);

            for(int i = 0; i < starVertices.Count; i++)
            {
                 var start = starVertices[i];
                 var end = starVertices[(i + 1) % starVertices.Count];
                 DrawLine(grid, start, end);
            }
            PrintGrid(grid);
        }
        static List<(double x, double y)> GetStarVertices(double centerX, centerY, double outerRadius, double innerRadius, int points)
        {
            var vertices =  new List<(double x, double y)>();

            int totalPoints = points * 2;
            double angleStep = Math.PI / points;
            double starAngle = -Math.PI / 2; // starting pointing up

            for (int i = 0; i < totalPoints; i++)
            {
                double angle = starAngle + angleStep * i;

                double radius = (i % 2 == 0) ? outerRadius : innerRadius;

                double x = centerX = Math.Cos(angle) * radius *2.2;

                double y = center + Math.Sin(angle) * radius;

                vertices.Add((x, y));
            }
            return vertices;
        }
        static void DrawLine(char[,] grid, (double x, double y) start,(double x, double y)end)
        {
            int steps = (int)Math.Max(Math.Abs(end.x - start.x), Math.Abs(end.y - start.y)) + 1;
            for (int i =0; i<= steps; i++)
            {
                 double t = (double)i / steps;
                 int x = (int)Math.Rounds(start.x + (end.x - start.x)*t);
                 int y = (int)Math.Rounds(start.y + (end.y - start.y)*t);
                 if(y >=0 && y < GridHeight && x >=0 && x <GridWidth)
                 {
                     grid[y, x] ='*';
                 }
            }
        }
        static void PrintGrid(char[,] grid)
        {
            for (int r = 0; r < GridHeight; r++)
            {
                for (int c = 0; c < GridWidth; c++)
                {
                    Console.Write(grid[r, c]);
                }
                Console.WriteLine();
            }
        }
    }
}
